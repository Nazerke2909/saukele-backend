generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COUPLE
  FAMILY_MEMBER
  GUEST
  MODERATOR
}

enum KinshipRank {
  ATA_ANA
  ZHIEN_ZHARAP
  SHAKYRT
}

enum PoolStatus {
  PENDING
  FUNDING
  FUNDED
  PURCHASED
  DELIVERED
}

enum ContributionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}


enum DeliveryStatus {
  PREPARING
  HANDED_TO_CARRIER
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum PrivacyLevel {
  PUBLIC
  FAMILY_ONLY
  PRIVATE
}

model User {
  id             Int     @id @default(autoincrement())
  email          String  @unique
  hashedPassword String  @map("hashed_password")
  role           Role
  fullName       String  @map("full_name")
  isBlocked      Boolean @default(false) @map("is_blocked")

  emailVerified    Boolean   @default(false) @map("email_verified")
  verificationCode String?   @map("verification_code")
  resetToken       String?   @map("reset_token")
  resetTokenExp    DateTime? @map("reset_token_exp")

  refreshTokenHash String? @map("refresh_token_hash")

  createdAt DateTime @default(now()) @map("created_at")

  weddingsAsCouple  Wedding[]      @relation("coupleWeddings")
  familyMemberships FamilyTree[]   @relation("familyMember")
  familyAncestors   FamilyTree[]   @relation("familyAncestor")
  contributions     Contribution[]
  auditLogs         AuditLog[]
  registries        Registry[]     @relation("registryCouple")

  @@index([email])
  @@map("users")
}

model Wedding {
  id        Int      @id @default(autoincrement())
  coupleId  Int      @map("couple_id")
  title     String
  date      DateTime
  location  String?
  createdAt DateTime @default(now()) @map("created_at")

  couple     User         @relation("coupleWeddings", fields: [coupleId], references: [id])
  giftPools  GiftPool[]
  familyTree FamilyTree[]
  registry   Registry?    @relation("weddingRegistry")

  @@index([coupleId])
  @@map("weddings")
}

model FamilyTree {
  id             Int         @id @default(autoincrement())
  weddingId      Int         @map("wedding_id")
  memberId       Int         @map("member_id")
  ancestorId     Int?        @map("ancestor_id")
  kinshipRank    KinshipRank @map("kinship_rank")
  customDistance Int?        @map("custom_distance")
  giftObligation Int?        @map("gift_obligation")
  createdAt      DateTime    @default(now()) @map("created_at")

  wedding  Wedding @relation(fields: [weddingId], references: [id])
  member   User    @relation("familyMember", fields: [memberId], references: [id])
  ancestor User?   @relation("familyAncestor", fields: [ancestorId], references: [id])

  @@unique([weddingId, memberId])
  @@index([weddingId, kinshipRank])
  @@index([weddingId, ancestorId])
  @@map("family_trees")
}

model GiftPool {
  id              Int          @id @default(autoincrement())
  weddingId       Int          @map("wedding_id")
  registryId      Int?         @map("registry_id")
  name            String
  description     String?
  targetKzt       Int          @map("target_kzt")
  targetAmount    Float?       @map("target_amount")
  targetCurrency  String?      @default("KZT") @map("target_currency")
  remainingTarget Int          @map("remaining_target")
  totalFunded     Int          @default(0) @map("total_funded")
  privacy         PrivacyLevel @default(PUBLIC) @map("privacy")
  isFragile       Boolean      @default(false) @map("is_fragile")
  status          PoolStatus   @default(PENDING)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  wedding        Wedding            @relation(fields: [weddingId], references: [id])
  registry       Registry?          @relation(fields: [registryId], references: [id])
  contributions  Contribution[]
  logisticsTrack LogisticsTracking?

  @@index([weddingId, status])
  @@map("gift_pools")
}

enum TraditionalGiftType {
  SAUKELE
  SUT_AKY
  KARZHY
}

model Registry {
  id        Int      @id @default(autoincrement())
  weddingId Int      @unique @map("wedding_id")
  coupleId  Int      @map("couple_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wedding   Wedding    @relation("weddingRegistry", fields: [weddingId], references: [id])
  couple    User       @relation("registryCouple", fields: [coupleId], references: [id])
  giftPools GiftPool[]

  @@index([weddingId])
  @@map("registries")
}

model LogisticsTracking {
  id                 Int            @id @default(autoincrement())
  poolId             Int            @unique @map("pool_id")
  deliveryStatus     DeliveryStatus @default(PREPARING) @map("delivery_status")
  carrierName        String?        @map("carrier_name")
  trackingNumber     String?        @unique @map("tracking_number")
  carrierNotes       String?        @map("carrier_notes")
  fragileWarningSent Boolean        @default(false) @map("fragile_warning_sent")
  estimatedDelivery  DateTime?      @map("estimated_delivery")
  deliveredAt        DateTime?      @map("delivered_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  pool GiftPool @relation(fields: [poolId], references: [id])

  @@index([deliveryStatus])
  @@index([trackingNumber])
  @@map("logistics_tracking")
}

model Contribution {
  id               Int                @id @default(autoincrement())
  guestId          Int                @map("guest_id")
  poolId           Int                @map("pool_id")
  amountKzt        Int                @map("amount_kzt")
  originalAmount   Float              @map("original_amount")
  originalCurrency String             @map("original_currency")
  exchangeRate     Float              @map("exchange_rate")
  lockedAt         DateTime           @default(now()) @map("locked_at")
  status           ContributionStatus @default(PENDING)
  paymentIntentId  String?            @unique @map("payment_intent_id")
  createdAt        DateTime           @default(now()) @map("created_at")

  guest User     @relation(fields: [guestId], references: [id])
  pool  GiftPool @relation(fields: [poolId], references: [id])

  @@index([poolId, status])
  @@index([guestId])
  @@map("contributions")
}

model ExchangeRateSnapshot {
  id           Int      @id @default(autoincrement())
  currencyFrom String   @map("currency_from")
  currencyTo   String   @map("currency_to")
  rate         Float
  lockedAt     DateTime @default(now()) @map("locked_at")
  source       String   @default("manual")

  @@index([currencyFrom, currencyTo, lockedAt])
  @@map("exchange_rate_snapshots")
}

model ExchangeRate {
  id           Int       @id @default(autoincrement())
  currencyFrom String    @map("currency_from")
  currencyTo   String    @map("currency_to")
  rate         Float
  validFrom    DateTime  @default(now()) @map("valid_from")
  validUntil   DateTime? @map("valid_until")
  source       String    @default("manual")

  @@unique([currencyFrom, validFrom])
  @@map("exchange_rates")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
