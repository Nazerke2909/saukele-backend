# ============================================
# Saukele — Environment Configuration Example
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# ---------- Database ----------
DATABASE_URL="postgresql://user:password@localhost:5432/saukele?schema=public"

# ---------- Redis ----------
REDIS_URL="redis://localhost:6379"

# ---------- Server ----------
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# ---------- CORS ----------
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# ---------- Authentication (JWT) ----------
SECRET_KEY="your-jwt-secret-key-at-least-16-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Frontend ----------
FRONTEND_URL="http://localhost:3000"

# ---------- Email (Mailgun) ----------
SMTP_FROM="noreply@saukele.kz"

# To enable Mailgun email sending, fill in these:
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SMTP_HOST=smtp.mailgun.org
MAILGUN_SMTP_PORT=587
MAILGUN_SMTP_USER=
MAILGUN_SMTP_PASS=
