# ==========================================
# Saukele – Wedding Gift Management System
# ==========================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ==========================================

# ---------- Server ----------
PORT=3000
NODE_ENV=development

# ---------- Database (PostgreSQL) ----------
DATABASE_URL="postgresql://saukele:saukele_pass@localhost:5432/saukele?schema=public"

# ---------- Redis ----------
REDIS_URL="redis://localhost:6379"

# ---------- JWT (at least 16 characters) ----------
# Generate: openssl rand -base64 32
JWT_SECRET="change-me-to-a-random-secret-at-least-16-chars"
REFRESH_TOKEN_SECRET="change-me-to-another-random-secret-at-least-16-chars"

# ---------- CORS ----------
# Comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-ethereal-user
SMTP_PASS=your-ethereal-pass
SMTP_FROM=noreply@saukele.kz
APP_URL=http://localhost:3000