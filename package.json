{
  "name": "express-saukele",
  "version": "1.0.0",
  "description": "Wedding gift management system",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "worker": "node src/queue/worker.js",
    "start:all": "node src/app.js & node src/queue/worker.js",
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit --detectOpenHandles",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit --detectOpenHandles tests/integration",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "prisma:generate": "npx prisma generate"
  },
  "dependencies": {
    "@bull-board/api": "^7.0.0",
    "@bull-board/express": "^7.0.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.7",
    "prisma": "^5.22.0",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  }
}
